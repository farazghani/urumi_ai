# Copy to Dashboard/.env; Docker Compose reads it automatically.
DASHBOARD_PORT=8001
ADMIN_EMAIL=admin@urumi.local
# Optional initial admin password. Omit to generate /data/bootstrap-admin.txt.
# ADMIN_PASSWORD=
# On Docker Desktop, this reaches the existing WooCommerce MCP host port.
WOO_MCP_URL=http://host.docker.internal:8000/mcp
# OPENROUTER_MODEL=provider/model-name
# OPENROUTER_API_KEY=
# Set to 1 only when serving the browser over HTTPS.
COOKIE_SECURE=0

# Dashboard database: separate MariaDB image, database and volume from WooCommerce.
MYSQL_DATABASE=urumi_dashboard
MYSQL_USER=urumi
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
