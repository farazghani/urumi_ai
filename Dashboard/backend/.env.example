# Export these before launch. The dashboard does not automatically load this file.
ADMIN_EMAIL=admin@urumi.local
# Set a strong initial admin password, or omit to generate .data/bootstrap-admin.txt.
# ADMIN_PASSWORD=
# Used only when seeding a brand-new database. Edit existing URLs in the dashboard.
WOO_MCP_URL=http://127.0.0.1:8000/mcp
# Optional bearer token for the initial WooCommerce upstream (fresh databases only).
# WOO_MCP_AUTH_TOKEN=
# OpenRouter is the only chat provider. No base URL is needed.
# OPENROUTER_MODEL=provider/model-name
# OPENROUTER_API_KEY=
# COOKIE_SECURE=1
# DASHBOARD_DATA=/absolute/path/to/private/data
# Optional read-only Fernet key file, e.g. a mounted Kubernetes Secret.
# ENCRYPTION_KEY_FILE=/run/secrets/dashboard/encryption-key

# Dashboard database: separate MariaDB image, database and volume from WooCommerce.
MYSQL_DATABASE=urumi_dashboard
MYSQL_USER=urumi
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
